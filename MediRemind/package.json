{
  "name": "mediremind",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_PUBLIC_IAP=mock expo start",
    "android": "EXPO_PUBLIC_IAP=mock expo start --android",
    "ios": "EXPO_PUBLIC_IAP=mock expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:prod:android": "eas build --platform android --profile production",
    "update:production": "eas update --channel production --message",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "icons": "NODE_PATH=$(npm root -g) node scripts/generate-icons.js",
    "screenshots": "NODE_PATH=$(npm root -g) node scripts/store-screenshots.js",
    "design-sheet": "node scripts/design-sheet.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@supabase/supabase-js": "2.117.3",
    "date-fns": "^3.6.0",
    "expo": "~56.0.8",
    "expo-constants": "~56.0.27",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-haptics": "~56.0.3",
    "expo-notifications": "~56.0.26",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.16",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.28",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-iap": "15.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-jest": "^30.4.1",
    "babel-preset-expo": "^56.0.14",
    "jest": "^30.4.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
